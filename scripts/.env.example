# Copy to .env in project root and fill in locally. NEVER commit .env
#
#   cp scripts/.env.example .env
#   source .env   # or: export $(grep -v '^#' .env | xargs)

# Commerzbank online banking credentials
FINTS_USER=0123456789
FINTS_PIN=your-pin-here

# Commerzbank FinTS defaults (usually no change needed)
FINTS_BLZ=20080000
FINTS_URL=https://fints.commerzbank.de/fints

# After Deutsche Kreditwirtschaft product registration (~10-15 days):
# FINTS_PRODUCT_ID=YOUR-ASSIGNED-PRODUCT-ID
